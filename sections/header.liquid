{%- assign logo = section.settings.logo -%}


<header class="border-b">

    <div class="container mx-auto py-4 flex justify-between lg:items-center">
        <div class="hidden lg:flex items-center lg:items-start">
            <span class="hidden gap-2 md:flex items-center">

                {% render 'icon-message' %}
                Stay on trend

            </span>
        </div>
        <div class="flex-1 flex lg:text-center items-start">
            <a href="{{ routes.root_url }}" class="flex mx-auto">  
            {%- if logo -%}
                {{ logo | image_url: width: 200 | image_tag: class: 'h-8', alt: shop.name }}
            {%- else -%}

            <span class="text-lg font-bold">LOGO</span>
            {%- endif -%}

            </a>

        </div>
        <div class="flex gap-4 items-center">
            <div class="h-6 w-6">
                {% render 'icon-search' %}
            </div>
             <div class="h-6 w-6">
                {% render 'icon-user' %}
            </div>
             <div class="h-6 w-6">
                {% render 'icon-favorite' %}
            </div>
             <div class="h-6 w-6">
                {% render 'icon-bag' %}
            </div>
            <button class="block md:hidden menuBar">
                {% render 'icon-mobile' %}
            </button>




        </div>


    </div>

    <nav class="container mx-auto py-2 justify-center space-x-6 hidden md:flex">
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">HOME</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">SHOP</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">FEATURES</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">LOOKBOOK</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">PAGES</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">BLOG</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">BUY NOW!</a>

    </nav>

    <nav class="mobilMenu container mx-auto py-2 items-center justify-center space-y-8 flex flex-col md:hidden hidden">
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">HOME</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">SHOP</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">FEATURES</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">LOOKBOOK</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">PAGES</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">BLOG</a>
        <a href="#" class="text-sm text-gray-600 hover:text-gray-800">BUY NOW!</a>

    </nav>

</header>


