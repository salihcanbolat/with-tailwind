{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Damla pages may do: listen and emit between windows, show, hide, move and size them.",
  "windows": ["core", "panel", "strip", "toast"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-focus"
  ]
}
